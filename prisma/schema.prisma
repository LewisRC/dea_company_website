// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 产品表
model Product {
  id          Int      @id @default(autoincrement())
  name        String   // 中文名称
  nameEn      String?  // 英文名称
  category    String   // 中文分类
  categoryEn  String?  // 英文分类
  description String?  // 中文描述
  descriptionEn String? // 英文描述
  image       String
  href        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 轮播图表
model Carousel {
  id             Int      @id @default(autoincrement())
  title          String   // 中文标题
  titleEn        String?  // 英文标题
  subtitle       String?  // 中文副标题
  subtitleEn     String?  // 英文副标题
  image          String   // 桌面端图片路径
  imageEn        String?  // 桌面端英文图片路径
  imageMobile    String?  // 移动端图片路径
  imageMobileEn  String?  // 移动端英文图片路径
  link           String?  // 链接
  order          Int      @default(0) // 排序
  isActive       Boolean  @default(true) // 是否启用
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// 案例表
model Case {
  id            Int      @id @default(autoincrement())
  title         String   // 中文标题
  titleEn       String?  // 英文标题
  description   String   // 中文描述
  descriptionEn String?  // 英文描述
  image         String   // 图片路径
  badge         String?  // 中文徽章
  badgeEn       String?  // 英文徽章
  tags          String?  // 标签（JSON 数组）
  tagsEn        String?  // 英文标签（JSON 数组）
  order         Int      @default(0) // 排序
  isActive      Boolean  @default(true) // 是否启用
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// 管理员表
model Admin {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String   // 加密后的密码
  createdAt DateTime @default(now())
}
